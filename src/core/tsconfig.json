{
  // Deliberately CommonJS even though package.json sets "type": "module":
  // src/core is only ever loaded at runtime by src/main (a real Node/CJS
  // require() graph, not bundled by Vite — the renderer instead compiles
  // this package straight from .ts source via esbuild, so this outDir
  // format has no effect on it). Emitting ESNext here left extensionless
  // relative imports (e.g. `from "../shared/domain"`) unresolvable by
  // Node's ESM loader at real Electron launch (see packaging apply-progress).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/core",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "references": [{ "path": "../shared" }]
}
